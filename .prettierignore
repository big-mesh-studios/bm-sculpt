# The lockfile and the workspace config are not Prettier's to reformat. The workspace
# config in particular is hand-aligned, and a formatter reflowing it would make every
# catalog change look larger than it is.
pnpm-lock.yaml
pnpm-workspace.yaml

# Build output, in whichever workspace produced it.
dist
dist-*
# The front page's compiled server bundle, produced by the same build that writes
# `dist/index.html`. It is a bundle — a build product, not source — so formatting it
# would mean formatting something the compiler emits and would fail again on every
# build. `.gitignore` already excludes it; Prettier does not read that.
.ssr
node_modules
*.tsbuildinfo
.DS_Store
