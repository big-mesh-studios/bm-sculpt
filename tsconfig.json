{
  // The root workspace's own TypeScript: the tools, and nothing else.
  //
  // **This is the seventh tsconfig the base comment counts, and the only one with no DOM.**
  // `tools/` is Node — it reads `package.json` files off a disk during CI — and giving it
  // the browser's globals would mean a tool could call `document.querySelector` and
  // type-check, failing only when the check actually ran. Dropping `DOM` from `lib` and
  // setting `types: ["node"]` makes the absence part of the type rather than a comment.
  //
  // It exists at all because these files used to sit inside `src/` and were covered by the
  // application's tsconfig. Splitting the monorepo moved them to the root, where
  // `pnpm -r check-types` does not look, so a broken tool would have type-checked nowhere.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["tools"]
}
