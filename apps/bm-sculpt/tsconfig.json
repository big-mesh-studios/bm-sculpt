{
  // The five packages this application shares with the SDF modeller carry the shared half of
  // the compiler options; what is here is what makes this an *application* rather than a library.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `exactOptionalPropertyTypes` is off, and the reason is worth keeping in the file
    // rather than in a memory: it is correct, and it makes every optional field that is
    // genuinely optional — half of the worker protocol — a `{ field?: T | undefined }`
    // written out at every call site that omits it.
    //
    // Solid's JSX is compiled, not interpreted: `preserve` hands the
    // transform to `vite-plugin-solid`, which is the only thing that knows how
    // to turn it into DOM calls. Importing from `@solidjs/web` rather than
    // `solid-js` is what puts the DOM runtime in scope for the transform.
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",

    // Allows `import "./thing.ts"` in the Node-run scripts under `tools/` and
    // `e2e/`, which Node executes with type stripping rather than a bundler.
    // Imports inside `src/` stay extensionless.
    "allowImportingTsExtensions": true,

    // **`DOM.Iterable` and not just `DOM`.** The base gives every workspace
    // `["ESNext", "DOM"]`, and a `NodeListOf` is not iterable without it — so
    // `[...root.querySelectorAll("li")]` in a mounted-component test is a type
    // error here and in no package, because the base's lib list is the floor and
    // an application is the one that walks the DOM.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // So that a place's source — `src/places/demo/*.ts` — type-checks here rather than only
    // when a person is reading it. A place imports `voxelscape`, which is not a package: it is
    // the guest library in `guest/place-api.ts`, reached through the two-line alias in
    // `guest/voxelscape.ts`. Without this, `tsc` cannot resolve a place's imports, the demos
    // would be the only TypeScript in the repository that nothing checks, and a typo in an
    // effect's field name would surface at runtime as a refusal rather than at compile time as
    // an error.
    //
    // **A place author's own project needs the same line**, and it is in `voxelscape.ts`'s
    // header. It is here because the demos are places.
    "paths": {
      "voxelscape": ["./src/places/guest/voxelscape.ts"]
    },

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "types": ["vite/client"]
  },
  "include": ["src"]
}
